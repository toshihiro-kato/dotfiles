layout {
    pane size=1 borderless=true {
        plugin location="compact-bar"
    }
    pane split_direction="vertical" size="100%" {
        pane split_direction="horizontal" size="50%" {
            pane size="50%"
            pane size="50%"
        }
        pane split_direction="horizontal" size="50%" {
            pane size="25%"
            pane size="25%"
            pane size="25%"
            pane size="25%"
        }
    }
    pane size=2 borderless=true {
        plugin location="status-bar"
    }
}
